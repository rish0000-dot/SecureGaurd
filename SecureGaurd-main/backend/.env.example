# Server Configuration
PORT=5000

# Security & Authentication Secrets
JWT_SECRET=your_super_secret_access_jwt_key_here
JWT_REFRESH_SECRET=your_super_secret_refresh_jwt_key_here
ENCRYPTION_KEY=32_byte_hex_key_for_aes_256_gcm_token_encryption
WEBHOOK_SECRET=your_github_gitlab_webhook_hmac_secret

# Database URL (PostgreSQL via Prisma)
DATABASE_URL="postgresql://user:password@localhost:5432/secureguard?schema=public"

# Python ML FP Classifier Service
FP_CLASSIFIER_URL="http://localhost:8001"
CLASSIFIER_API_KEY="sg-internal-fp-classifier-key-placeholder"

# AI Fix Engine Configuration
GEMINI_API_KEY=""
GEMINI_WEB2API_URL="http://localhost:8081/v1"
GEMINI_WEB2API_KEY="sk-gemini"

# Retrain Scheduler Config
RETRAIN_SCHEDULE_HOURS=24
MIN_FEEDBACK_TO_RETRAIN=100
